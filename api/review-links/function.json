{
  "bindings": [
    {
      "authLevel": "anonymous",
      "type": "httpTrigger",
      "direction": "in",
      "name": "req",
      "methods": ["get", "post"],
      "route": "review-links/{bucket}/{id}"
    },
    {
      "type": "http",
      "direction": "out",
      "name": "res"
    },
    {
      "type": "table",
      "direction": "in",
      "name": "storedLink",
      "tableName": "QuoteReviewLinks",
      "partitionKey": "links",
      "connection": "QRV_STORAGE"
    },
    {
      "type": "table",
      "direction": "out",
      "name": "savedLink",
      "tableName": "QuoteReviewLinks",
      "connection": "QRV_STORAGE"
    },
    {
      "type": "table",
      "direction": "in",
      "name": "rateRows",
      "tableName": "QuoteReviewRate",
      "partitionKey": "{bucket}",
      "connection": "QRV_STORAGE"
    },
    {
      "type": "table",
      "direction": "out",
      "name": "savedRate",
      "tableName": "QuoteReviewRate",
      "connection": "QRV_STORAGE"
    }
  ]
}
